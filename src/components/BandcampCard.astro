---
const { title, trackId, desc, url, badge, tags, target = "_blank", etsyUrl } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        
          <iframe 
            class="max-w-full md:max-w-[13rem] rounded-lg bg-white"
            style="border: 0; height: 350px;" 
            src={`https://bandcamp.com/EmbeddedPlayer/track=${trackId}/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/`} 
            seamless>
        </iframe>
        
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
  {etsyUrl && (
      <div class="px-8 pt-6 pb-6 flex justify-end">
        <a href={etsyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning font-semibold">
          Inspired by the hand-knapped blade — Collect the physical artifact on Etsy →
        </a>
      </div>
    )}
</div>
