---
const { trackId, etsyUrl } = Astro.props;
---
<div class="flex w-full flex-col items-center">
  <iframe 
    class="block"
    style="border: 0; width: 100%; height: 400px;" 
    src={`https://bandcamp.com/EmbeddedPlayer/track=${trackId}/size=large/bgcol=241524/linkcol=D4AF37/tracklist=false/transparent=true/`}
    seamless>
  </iframe>
  {etsyUrl && (
    <div class="mt-0 w-full flex justify-center">
      <a href={etsyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning font-semibold">
        Inspired by the hand-knapped blade
        <br /> Collect the physical artifact on Etsy →
      </a>
    </div>
  )}
</div>
